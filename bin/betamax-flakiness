#!/bin/bash
# betamax-flakiness - Comprehensive test flakiness analyzer
# Analyzes test execution history and generates detailed flakiness reports

set -e

# Resolve script directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Source libraries
source "$PROJECT_DIR/lib/flakiness_collector.sh"
source "$PROJECT_DIR/lib/flakiness_analyzer.sh"
source "$PROJECT_DIR/lib/flakiness_reporter.sh"

# Default values
FLAKINESS_TMPDIR="${FLAKINESS_TMPDIR:-.betamax_flakiness}"
OUTPUT_DIR="${OUTPUT_DIR:-.}"
REPORT_FORMAT="json,html,txt"  # All formats by default
ANALYZE_ONLY=false
CLEANUP=false

# Print usage
usage() {
  cat << 'EOF'
betamax-flakiness - Analyze test flakiness and generate reports

Usage:
  betamax-flakiness [OPTIONS] [COMMAND]

Commands:
  analyze       Compute metrics and generate reports (default)
  collect       Record test execution (used internally)
  clean         Clean up flakiness data
  help          Show this help message

Options:
  -f, --format FORMAT    Output formats: json, html, txt (comma-separated)
  -o, --output DIR       Output directory (default: current directory)
  --collect TEST PASS MS Record a test execution
  --cleanup              Clean up flakiness database after reporting
  -v, --verbose          Verbose output

Examples:
  betamax-flakiness analyze
  betamax-flakiness analyze --format json
  betamax-flakiness --cleanup
  betamax-flakiness --collect "test name" true 150
EOF
}

# Parse command line arguments
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--format)
        REPORT_FORMAT="$2"
        shift 2
        ;;
      -o|--output)
        OUTPUT_DIR="$2"
        shift 2
        ;;
      --collect)
        local test_name="$2"
        local passed="$3"
        local duration_ms="$4"
        record_test_execution "$test_name" "$passed" "$duration_ms"
        exit 0
        ;;
      --cleanup)
        CLEANUP=true
        shift
        ;;
      -v|--verbose)
        set -x
        shift
        ;;
      analyze)
        shift
        ;;
      clean)
        cleanup_flakiness
        exit 0
        ;;
      help|--help|-h)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage
        exit 1
        ;;
    esac
  done
}

# Main analysis workflow
main() {
  parse_args "$@"

  # Initialize database if needed
  if [[ ! -d "$FLAKINESS_TMPDIR" ]]; then
    echo "No test data found. Run tests with --analyze-flakiness first."
    exit 1
  fi

  mkdir -p "$OUTPUT_DIR"

  # Compute metrics
  echo "Computing flakiness metrics..."
  local metrics_json
  metrics_json=$(compute_flakiness_metrics)

  # Generate reports in requested formats
  export METRICS_JSON="$metrics_json"
  for format in $(echo "$REPORT_FORMAT" | tr ',' ' '); do
    case "$format" in
      json)
        export OUTPUT_FILE="$OUTPUT_DIR/flakiness-report.json"
        generate_json_report "$OUTPUT_DIR/flakiness-report.json"
        ;;
      html)
        export OUTPUT_FILE="$OUTPUT_DIR/flakiness-report.html"
        generate_html_report "$OUTPUT_DIR/flakiness-report.html"
        ;;
      txt)
        export OUTPUT_FILE="$OUTPUT_DIR/flakiness-report.txt"
        generate_text_report "$OUTPUT_DIR/flakiness-report.txt"
        ;;
      *)
        echo "Unknown format: $format" >&2
        ;;
    esac
  done

  # Cleanup if requested
  if [[ "$CLEANUP" == true ]]; then
    cleanup_flakiness
    echo "Cleaned up flakiness data"
  fi

  echo "Reports generated in $OUTPUT_DIR"
}

main "$@"
